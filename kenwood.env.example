# Werte stehen in der Kenwood-World-App (com.kenwood.world), Klasse
# com.adaptics.dropkitchen.base.BuildConfig: OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET.
# Diese Datei als kenwood.env kopieren und ausfüllen – kenwood.env wird nicht committet.
KW_CLIENT_ID=
KW_CLIENT_SECRET=
# KW_API_BASE_URL=https://api.getdrop.io
# Heim-WLAN für die Maschine (2,4 GHz, WPA2)
KW_HOME_SSID=
